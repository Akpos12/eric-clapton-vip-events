{
  "entities": {
    "ConcertEvent": {
      "title": "ConcertEvent",
      "description": "Eric Clapton Tour Concert Date and Venue Information",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "tourName": { "type": "string" },
        "venue": { "type": "string" },
        "city": { "type": "string" },
        "country": { "type": "string" },
        "eventDate": { "type": "string" },
        "doorsOpenTime": { "type": "string" },
        "showStartTime": { "type": "string" },
        "curfewTime": { "type": "string" },
        "image": { "type": "string" },
        "status": { "type": "string" },
        "capacity": { "type": "number" },
        "ticketCategories": { "type": "array" }
      },
      "required": ["id", "title", "venue", "city", "eventDate"]
    },
    "VIPExperiencePackage": {
      "title": "VIPExperiencePackage",
      "description": "VIP Tier Packages and Inclusions",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "tierCode": { "type": "string" },
        "price": { "type": "number" },
        "description": { "type": "string" },
        "inclusions": { "type": "array" }
      },
      "required": ["id", "name", "tierCode", "price"]
    },
    "TicketOrder": {
      "title": "TicketOrder",
      "description": "Customer Ticket & VIP Purchase Record",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "orderNumber": { "type": "string" },
        "eventId": { "type": "string" },
        "customerName": { "type": "string" },
        "customerEmail": { "type": "string" },
        "customerPhone": { "type": "string" },
        "quantity": { "type": "number" },
        "totalAmount": { "type": "number" },
        "currency": { "type": "string" },
        "paymentStatus": { "type": "string" },
        "tickets": { "type": "array" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "orderNumber", "customerEmail", "quantity", "totalAmount"]
    },
    "MeetGreetRequest": {
      "title": "MeetGreetRequest",
      "description": "Artist Liaison Meet & Greet Fan Application",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "eventId": { "type": "string" },
        "applicantName": { "type": "string" },
        "applicantEmail": { "type": "string" },
        "applicantPhone": { "type": "string" },
        "reason": { "type": "string" },
        "status": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "eventId", "applicantName", "applicantEmail", "reason"]
    },
    "SupportTicket": {
      "title": "SupportTicket",
      "description": "Customer VIP Concierge Support Inquiries",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "customerName": { "type": "string" },
        "customerEmail": { "type": "string" },
        "subject": { "type": "string" },
        "message": { "type": "string" },
        "status": { "type": "string" },
        "priority": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "customerEmail", "subject", "message"]
    },
    "FanRewardGiveaway": {
      "title": "FanRewardGiveaway",
      "description": "Promotional Fan Giveaways & Sweepstakes",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "category": { "type": "string" },
        "description": { "type": "string" },
        "totalEntries": { "type": "number" },
        "isActive": { "type": "boolean" }
      },
      "required": ["id", "title", "category"]
    }
  },
  "firestore": {
    "/events/{eventId}": {
      "schema": "ConcertEvent",
      "description": "Concert tour dates and seating tier configurations"
    },
    "/vip_packages/{packageId}": {
      "schema": "VIPExperiencePackage",
      "description": "VIP package catalogs"
    },
    "/giveaways/{giveawayId}": {
      "schema": "FanRewardGiveaway",
      "description": "Fan giveaways and sweepstakes"
    },
    "/ticket_orders/{orderId}": {
      "schema": "TicketOrder",
      "description": "Customer ticket purchases and digital pass barcodes"
    },
    "/meet_greet_requests/{requestId}": {
      "schema": "MeetGreetRequest",
      "description": "Fan Meet & Greet applications"
    },
    "/support_tickets/{ticketId}": {
      "schema": "SupportTicket",
      "description": "Customer VIP concierge requests"
    }
  }
}
